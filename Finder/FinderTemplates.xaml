<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:f="clr-namespace:MacShell.Finder"
                    xmlns:c="clr-namespace:MacShell.Controls">

    <f:IndentConverter x:Key="IndentConv"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate x:Key="TagDot">
        <Ellipse Width="8" Height="8" Margin="0,0,-2,0" Stroke="#40FFFFFF" StrokeThickness="0.8">
            <Ellipse.Fill><SolidColorBrush Color="{Binding}"/></Ellipse.Fill>
        </Ellipse>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <Style x:Key="RenameBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource MacFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource LabelBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="1,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Margin="-3" CornerRadius="5" BorderThickness="3" BorderBrush="{DynamicResource FocusRingBrush}"/>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Icon view cell -->
    <DataTemplate x:Key="IconCell" DataType="{x:Type f:FileItem}">
        <Grid Width="{DynamicResource FinderCellWidth}" Margin="0,5,0,5" Background="Transparent">
            <StackPanel HorizontalAlignment="Center">
                <Border x:Name="iconBox" Tag="hit" CornerRadius="6" Padding="4" HorizontalAlignment="Center" Background="Transparent">
                    <Image x:Name="img" Source="{Binding Icon}" Width="{DynamicResource FinderIconSize}" Height="{DynamicResource FinderIconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                </Border>
                <Border x:Name="labelBox" Tag="hit" CornerRadius="4" Padding="4,0.5,4,1" Margin="0,2,0,0" HorizontalAlignment="Center"
                        MaxWidth="{DynamicResource FinderLabelWidth}" Background="Transparent">
                    <DockPanel>
                        <ItemsControl x:Name="tags" DockPanel.Dock="Left" ItemsSource="{Binding TagColors}" ItemTemplate="{StaticResource TagDot}"
                                      ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Top" Margin="0,4,5,0" Visibility="Collapsed" Focusable="False"/>
                        <TextBlock x:Name="lbl" Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" FontSize="12" Foreground="{DynamicResource LabelBrush}"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="renameBox" Style="{StaticResource RenameBox}" Visibility="Collapsed" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                         MinWidth="60" MaxWidth="{DynamicResource FinderLabelWidth}" Margin="0,3,0,0" Tag="rename"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasTags}" Value="True">
                <Setter TargetName="tags" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="iconBox" Property="Background" Value="{DynamicResource SidebarSelectionActiveBrush}"/>
                <Setter TargetName="labelBox" Property="Background" Value="{DynamicResource UnfocusedSelectionBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding (f:FinderViewState.IsActive), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="labelBox" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                <Setter TargetName="lbl" Property="Foreground" Value="White"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="labelBox" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="renameBox" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCut}" Value="True">
                <Setter TargetName="img" Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="iconBox" Property="Background" Value="{DynamicResource PressedBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="IconRow" DataType="{x:Type f:IconRow}">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource IconCell}" ItemsPanel="{StaticResource HorizontalPanel}"
                      Focusable="False" Margin="{DynamicResource FinderRowMargin}"/>
    </DataTemplate>

    <!-- ============================================================ List view row -->
    <DataTemplate x:Key="ListRow" DataType="{x:Type f:FileItem}">
        <Border x:Name="sel" Tag="row" Height="24" Margin="10,0" CornerRadius="{Binding SelCorner}" Background="Transparent">
            <Grid Margin="6,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="{DynamicResource ColDateWidth}"/>
                    <ColumnDefinition Width="{DynamicResource ColSizeWidth}"/>
                    <ColumnDefinition Width="{DynamicResource ColKindWidth}"/>
                </Grid.ColumnDefinitions>
                <DockPanel Margin="{Binding Depth, Converter={StaticResource IndentConv}}">
                    <Grid x:Name="disclosure" Tag="disclosure" Width="14" Background="Transparent" DockPanel.Dock="Left" Visibility="Hidden">
                        <c:SymbolIcon x:Name="chev" Symbol="chevron.right" Width="9" Height="9" StrokeWidth="3" Foreground="{DynamicResource SecondaryLabelBrush}"
                                      RenderTransformOrigin="0.5,0.5"/>
                    </Grid>
                    <Image x:Name="img" Source="{Binding Icon}" Width="16" Height="16" Margin="3,0,6,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <ItemsControl x:Name="tags" DockPanel.Dock="Right" ItemsSource="{Binding TagColors}" ItemTemplate="{StaticResource TagDot}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" Margin="4,0,8,0" Visibility="Collapsed" Focusable="False"/>
                    <Grid>
                        <TextBlock x:Name="name" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LabelBrush}"/>
                        <TextBox x:Name="renameBox" Style="{StaticResource RenameBox}" Visibility="Collapsed" VerticalAlignment="Center" Tag="rename" FontSize="13"/>
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="date" Grid.Column="1" Text="{Binding ModifiedText}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryLabelBrush}"/>
                <TextBlock x:Name="size" Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{DynamicResource SecondaryLabelBrush}"/>
                <TextBlock x:Name="kind" Grid.Column="3" Text="{Binding Kind}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryLabelBrush}"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter TargetName="disclosure" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsApp}" Value="True">
                <Setter TargetName="disclosure" Property="Visibility" Value="Hidden"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="chev" Property="RenderTransform">
                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasTags}" Value="True">
                <Setter TargetName="tags" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource UnfocusedSelectionBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding (f:FinderViewState.IsActive), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
                <Setter TargetName="date" Property="Foreground" Value="#E6FFFFFF"/>
                <Setter TargetName="size" Property="Foreground" Value="#E6FFFFFF"/>
                <Setter TargetName="kind" Property="Foreground" Value="#E6FFFFFF"/>
                <Setter TargetName="chev" Property="Foreground" Value="White"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="name" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="renameBox" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCut}" Value="True">
                <Setter TargetName="img" Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ Column view row -->
    <DataTemplate x:Key="ColumnRow" DataType="{x:Type f:FileItem}">
        <Border x:Name="sel" Tag="row" Height="22" Margin="8,0" CornerRadius="5" Background="Transparent">
            <DockPanel Margin="6,0,6,0">
                <c:SymbolIcon x:Name="chev" DockPanel.Dock="Right" Symbol="chevron.right" Width="9" Height="9" StrokeWidth="3" Visibility="Collapsed"
                              Foreground="{DynamicResource SecondaryLabelBrush}" Margin="4,0,0,0"/>
                <ItemsControl x:Name="tags" DockPanel.Dock="Right" ItemsSource="{Binding TagColors}" ItemTemplate="{StaticResource TagDot}"
                              ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" Margin="4,0,2,0" Visibility="Collapsed" Focusable="False"/>
                <Image x:Name="img" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid>
                    <TextBlock x:Name="name" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LabelBrush}"/>
                    <TextBox x:Name="renameBox" Style="{StaticResource RenameBox}" Visibility="Collapsed" VerticalAlignment="Center" Tag="rename" FontSize="13"/>
                </Grid>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter TargetName="chev" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasTags}" Value="True">
                <Setter TargetName="tags" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource UnfocusedSelectionBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding (f:FinderViewState.IsActive), RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                <Setter TargetName="name" Property="Foreground" Value="White"/>
                <Setter TargetName="chev" Property="Foreground" Value="White"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="name" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="renameBox" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCut}" Value="True">
                <Setter TargetName="img" Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="sel" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ Desktop icon -->
    <DataTemplate x:Key="DesktopCell" DataType="{x:Type f:FileItem}">
        <StackPanel Width="{DynamicResource DesktopCellWidth}" HorizontalAlignment="Center">
            <Border x:Name="iconBox" Tag="hit" CornerRadius="6" Padding="4" HorizontalAlignment="Center" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                <Image x:Name="img" Source="{Binding Icon}" Width="{DynamicResource DesktopIconSize}" Height="{DynamicResource DesktopIconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
            </Border>
            <Border x:Name="labelBox" Tag="hit" CornerRadius="4" Padding="4,0.5,4,1" Margin="0,2,0,0" HorizontalAlignment="Center"
                    MaxWidth="{DynamicResource DesktopLabelWidth}" Background="Transparent">
                <DockPanel>
                    <ItemsControl x:Name="tags" DockPanel.Dock="Left" ItemsSource="{Binding TagColors}" ItemTemplate="{StaticResource TagDot}"
                                  ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Top" Margin="0,4,5,0" Visibility="Collapsed" Focusable="False"/>
                    <TextBlock x:Name="lbl" Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxHeight="32" FontSize="12" FontWeight="Medium" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.85" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </DockPanel>
            </Border>
            <TextBox x:Name="renameBox" Style="{StaticResource RenameBox}" Visibility="Collapsed" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                     MinWidth="60" MaxWidth="{DynamicResource DesktopLabelWidth}" Margin="0,3,0,0" Tag="rename"/>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasTags}" Value="True">
                <Setter TargetName="tags" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="iconBox" Property="Background" Value="#40000000"/>
                <Setter TargetName="iconBox" Property="BorderBrush" Value="#59FFFFFF"/>
                <Setter TargetName="labelBox" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="labelBox" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="renameBox" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCut}" Value="True">
                <Setter TargetName="img" Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StackExpanded}" Value="True">
                <Setter TargetName="img" Property="Opacity" Value="0.55"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="iconBox" Property="Background" Value="#55000000"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ Gallery filmstrip -->
    <DataTemplate x:Key="FilmThumb" DataType="{x:Type f:FileItem}">
        <Border x:Name="b" Tag="row" Width="62" Height="62" Margin="3,0" CornerRadius="7" BorderThickness="2.5" BorderBrush="Transparent" Padding="3" Background="Transparent">
            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
