<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MacShell</AssemblyName>
    <RootNamespace>MacShell</RootNamespace>
    <Product>MacShell</Product>
    <!-- = the latest release tag; bump it with every release so local builds are never older than GitHub -->
    <Version>1.3.0</Version>
    <NoWarn>CA1416;CS8632;CS0649;CS0169;CS0414</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inter: the NoDitherOS UI font, used by Preview so it looks exactly like NoDitherOS's (OFL, see Inter-LICENSE.txt) -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>


</Project>
