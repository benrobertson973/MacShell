<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MacShell</AssemblyName>
    <RootNamespace>MacShell</RootNamespace>
    <Product>MacShell</Product>
    <!-- = the latest release tag; bump it with every release so local builds are never older than GitHub -->
    <Version>1.6.0</Version>
    <NoWarn>CA1416;CS8632;CS0649;CS0169;CS0414</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WebView2's loader is a native DLL: inside the single exe (the updater replaces only MacShell.exe) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inter: the NoDitherOS UI font, used by Preview so it looks exactly like NoDitherOS's (OFL, see Inter-LICENSE.txt) -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mail: IMAP / SMTP / MIME (MIT; the Lite build has no S/MIME or PGP), and messages shown by Edge's engine -->
    <PackageReference Include="MailKitLite" Version="4.18.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>


</Project>
