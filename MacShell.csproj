<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MacShell</AssemblyName>
    <RootNamespace>MacShell</RootNamespace>
    <Product>MacShell</Product>
    <Version>1.0.0</Version>
    <NoWarn>CA1416;CS8632;CS0649;CS0169;CS0414</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- "release" only for builds made by the GitHub release workflow; those update themselves -->
    <UpdateChannel Condition="'$(UpdateChannel)' == ''">dev</UpdateChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateChannel" Value="$(UpdateChannel)" />
  </ItemGroup>

</Project>
